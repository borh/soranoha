{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc.local/schemas/source-emendations-v1.json",
  "type": "object",
  "required": ["emendations_version"],
  "additionalProperties": false,
  "properties": {
    "emendations_version": { "const": 1 },
    "emendation": {
      "type": "array",
      "items": { "$ref": "#/$defs/Emendation" }
    }
  },
  "$defs": {
    "Emendation": {
      "type": "object",
      "required": ["id", "work_id", "indexed_path", "transcribed", "emended", "evidence", "reviewer", "reviewed_at", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "work_id": { "type": "string", "minLength": 1 },
        "indexed_path": { "type": "string", "minLength": 1 },
        "transcribed": { "type": "string", "pattern": "^[^\\n\\r]+$" },
        "emended": { "type": "string", "pattern": "^[^\\n\\r]*$" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
