{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc.local/schemas/aat-oracle-cases-v2.json",
  "type": "object",
  "required": ["oracle_version", "evidence", "case"],
  "additionalProperties": false,
  "properties": {
    "oracle_version": { "const": 2 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Evidence" }
    },
    "case": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Case" }
    }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "required": ["id", "kind", "citation", "supports", "independent"],
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "reference_table",
            "unicode",
            "aozora_rule",
            "curator_note",
            "corpus",
            "corpus_alignment"
          ]
        },
        "citation": { "type": "string", "minLength": 1 },
        "locator": { "type": "string" },
        "url": { "type": "string" },
        "supports": { "type": "string", "minLength": 1 },
        "independent": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "ReviewEntry": {
      "type": "object",
      "required": ["status", "reviewer", "reviewed_at"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "disputed", "retired"]
        },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": { "type": "string" }
      }
    },
    "Case": {
      "type": "object",
      "required": [
        "id",
        "syntax_row_ids",
        "category",
        "source_utf8",
        "evidence_ids",
        "review",
        "projection"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "syntax_row_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "category": { "type": "string", "minLength": 1 },
        "source_utf8": { "type": "string", "minLength": 1 },
        "source_recognition": { "type": "string", "enum": ["linked", "unknown", "absent"] },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "review": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ReviewEntry" }
        },
        "notes": { "type": "string" },
        "projection": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Projection" }
        }
      }
    },
    "Projection": {
      "type": "object",
      "required": ["kind", "version", "status", "assertions"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["aat", "tei"] },
        "version": { "type": "integer", "minimum": 1 },
        "status": {
          "type": "string",
          "enum": ["historical", "active", "retired"]
        },
        "assertions": {
          "oneOf": [
            { "$ref": "#/$defs/OracleExpectations" },
            { "$ref": "#/$defs/TeiExpectations" }
          ]
        }
      }
    },
    "OracleExpectations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible_text": { "type": "string" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/NodeAssertion" }
        },
        "field_multiset": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldMultisetAssertion" }
        },
        "sequence": {
          "type": "array",
          "items": { "$ref": "#/$defs/SequenceAssertion" }
        },
        "gaiji": {
          "type": "array",
          "items": { "$ref": "#/$defs/GaijiAssertion" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/DiagnosticAssertion" }
        }
      }
    },
    "TeiExpectations": {
      "type": "object",
      "anyOf": [
        { "required": ["elements"] },
        { "required": ["element_multiset"] }
      ],
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TeiElementAssertion" }
        },
        "element_multiset": {
          "type": "array",
          "items": { "$ref": "#/$defs/ElementMultisetAssertion" }
        }
      }
    },
    "FieldMultisetAssertion": {
      "type": "object",
      "required": ["selector", "fields", "values"],
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "values": {
          "type": "array",
          "items": { "type": "array" }
        },
        "qualifies": { "$ref": "#/$defs/QualifiedAspects" },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ElementMultisetAssertion": {
      "type": "object",
      "required": ["selector", "fields", "values"],
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "values": {
          "type": "array",
          "items": { "type": "array" }
        },
        "qualifies": { "$ref": "#/$defs/QualifiedAspects" },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "TeiElementAssertion": {
      "type": "object",
      "required": ["selector"],
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
        "qualifies": { "$ref": "#/$defs/QualifiedAspects" },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "NodeAssertion": {
      "type": "object",
      "required": ["selector", "kind"],
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "min_count": { "type": "integer", "minimum": 0 },
        "absent": { "type": "boolean" },
        "fields": { "type": "object" },
        "field_absent": { "type": "array", "items": { "type": "string" } },
        "qualifies": { "$ref": "#/$defs/QualifiedAspects" },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "SequenceAssertion": {
      "type": "object",
      "required": ["selector", "kinds"],
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "qualifies": { "$ref": "#/$defs/QualifiedAspects" },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "GaijiAssertion": {
      "type": "object",
      "required": ["selector", "description", "resolved"],
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "resolved": { "type": ["string", "null"] },
        "jis_code": { "type": ["string", "null"] },
        "unresolved_reason": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "qualifies": { "$ref": "#/$defs/QualifiedAspects" },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "DiagnosticAssertion": {
      "type": "object",
      "required": ["selector", "fields"],
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "min_count": { "type": "integer", "minimum": 0 },
        "absent": { "type": "boolean" },
        "fields": { "type": "object", "minProperties": 1 },
        "field_absent": { "type": "array", "items": { "type": "string" } },
        "qualifies": { "$ref": "#/$defs/QualifiedAspects" },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "QualifiedAspects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["semantic-role", "source-span", "target", "scope", "value"]
      }
    }
  }
}
